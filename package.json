{
  "name": "@vascular-io/vascular-js",
  "version": "1.0.0",
  "description": "Vascular Javascript SDK",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "repository": "git@github.com:vascular-io/vascular-js.git",
  "author": "Vascular IO",
  "license": "Apache",
  "scripts": {
    "clean": "rm -rf dist",
    "types": "tsc --emitDeclarationOnly",
    "bundle": "node build.js",
    "flatten-types": "api-extractor run --local --verbose",
    "build": "npm run clean && npm run types && npm run bundle && npm run flatten-types && rm -rf dist/vascular dist/vascular.d.ts",
    "build-dev": "tsc --project tsconfig.json && cp src/vascular/*.{js,d.ts} dist/vascular/",
    "build:watch": "nodemon --watch ./src --ext ts --exec tsc",
    "prepublishOnly": "npm pkg delete devDependencies && npm publish --access public && git checkout package.json"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.10",
    "@types/long": "^4.0.1",
    "@types/node": "^17.0.10",
    "esbuild": "^0.25.8",
    "nodemon": "^2.0.15",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.4",
    "xhr2": "^0.2.1"
  },
  "dependencies": {
    "google-protobuf": "^3.20.1",
    "grpc-web": "^1.3.1"
  },
  "publishConfig": {
  "access": "public"
}
}
